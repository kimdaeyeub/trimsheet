{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": [
			"ESNext"
		],
		"types": [
			"node"
		],
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		"paths": {
			"@shared/*": [
				"../shared/*"
			]
		}
	},
	"include": [
		"src",
		"test",
		"worker-configuration.d.ts",
		"../shared"
	]
}
