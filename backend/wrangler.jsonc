{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "trimsheet-backend",
	// No public URL: the frontend Worker reaches this Worker only through its service binding
	// (PLAN.md §8.5). Cron triggers and Durable Objects keep working without a public route.
	"workers_dev": false,
	"preview_urls": false,
	"compatibility_date": "2026-11-08",
	"compatibility_flags": ["nodejs_compat"],
	// Workers Logs + Traces. Flue adds agent-level spans to each trace:
	// https://flueframework.com/docs/guide/observability/#cloudflare
	"observability": { "enabled": true, "traces": { "enabled": true } },
	// Workers AI — Flue routes `cloudflare/@cf/...` models through this binding.
	"ai": { "binding": "AI", "remote": true },
	// PDFs, job state, locks, intermediate extraction results.
	"r2_buckets": [{ "binding": "FILES", "bucket_name": "trimsheet-files" }],
	// Browser Run for crawling manufacturer pages (used from Phase 5).
	"browser": { "binding": "BROWSER" },
	// New-data email (Cloudflare Email Service). Needs a domain onboarded to Email Service and the
	// sender address in NOTIFY_FROM. Workers Free can only send to verified destination addresses
	// (Email Routing); any address needs Workers Paid. Locally the binding is simulated (no mail sent).
	"send_email": [{ "name": "EMAIL" }],
	// Weekly scan: Monday 00:00 UTC = 09:00 KST (used from Phase 6).
	"triggers": { "crons": ["0 0 * * 1"] },
	// Google Sheets and OpenAI settings are NOT kept here (this repository is public):
	// GOOGLE_SPREADSHEET_ID, GOOGLE_SERVICE_ACCOUNT_EMAIL, GOOGLE_PRIVATE_KEY, OPENAI_API_KEY,
	// NOTIFY_FROM (email sender, e.g. trimsheet@your-domain.com), APP_URL (link in emails)
	// live in backend/.env locally and are set with `wrangler secret put` in production.
	// Every agent generates a Durable Object class named after its identity
	// (TrimSheet -> FlueTrimSheetAgent). Append a new tag when you add an agent:
	// https://flueframework.com/docs/guide/cloudflare-target/#managing-migrations
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["FlueTrimSheetAgent"] },
		{ "tag": "v2", "new_sqlite_classes": ["FlueWatcherAgent"] }
	]
}
