# Copy to .env and fill in. Never commit real values.
# OpenAI fallback for PDFs GLM-4.7-Flash cannot read (PLAN.md §6.2)
OPENAI_API_KEY=
# Google Sheets (docs/google-sheets-setup.md) — spreadsheet ID from the sheet URL /d/<ID>/
GOOGLE_SPREADSHEET_ID=
# Google Sheets service account
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
# New-data email (docs/email-setup.md). Sender on a domain onboarded to Cloudflare Email Service.
NOTIFY_FROM=
# Optional: app address used as the link in emails (e.g. https://trimsheet-frontend.<account>.workers.dev)
APP_URL=
# Deployed only: shared key the Vercel /api proxy sends in x-trimsheet-key. Leave empty locally.
API_KEY=
