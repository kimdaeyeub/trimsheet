# Copy to .env and fill in. Never commit real values.
# OpenAI fallback for PDFs GLM-4.7-Flash cannot read (PLAN.md §6.2)
OPENAI_API_KEY=
# Google Sheets (docs/google-sheets-setup.md) — spreadsheet ID from the sheet URL /d/<ID>/
GOOGLE_SPREADSHEET_ID=
# Google Sheets service account
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
